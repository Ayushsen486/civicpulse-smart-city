# ==============================================================================
# CivicPulse — Production & Staging Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and substitute values for your target deployment.
# NEVER commit the '.env' file or production credentials to version control.
# ==============================================================================

# --- Database (PostgreSQL 16 + PostGIS 3.4) ---
POSTGRES_DB=civicpulse
POSTGRES_USER=civicpulse_admin
POSTGRES_PASSWORD=replace_with_strong_random_password_min_32_chars
POSTGRES_PORT=5432

# --- Cache & Session Store (Redis 7.2) ---
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_strong_redis_password_if_enabled

# --- Spring Boot Backend (Java 21 LTS) ---
SPRING_PROFILES_ACTIVE=prod
BACKEND_PORT=8080
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/civicpulse
SPRING_DATASOURCE_USERNAME=civicpulse_admin
SPRING_DATASOURCE_PASSWORD=replace_with_strong_random_password_min_32_chars
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# --- Security & JWT Authentication ---
# Generate a cryptographically secure 256-bit+ HMAC key (base64 encoded, >= 64 chars)
JWT_SECRET=replace_with_random_base64_hmac_sha256_key_at_least_64_characters_long
JWT_ACCESS_TOKEN_EXPIRY_MS=900000
JWT_REFRESH_TOKEN_EXPIRY_MS=604800000

# --- Network & CORS Allow-List ---
# Comma-separated list of approved web origins (No wildcards in production)
CORS_ALLOWED_ORIGINS=https://admin.yourcity.gov,https://app.yourcity.gov

# --- Reverse Proxy Gateway (Nginx) ---
GATEWAY_PORT=80
GATEWAY_SSL_PORT=443

# --- Web Admin Dashboard (React / Vite) ---
# In production with Nginx Gateway, relative path '/api/v1' routes through reverse proxy
VITE_API_BASE_URL=/api/v1
ADMIN_PORT=5173

# --- File Storage (Evidentiary Attachments) ---
# Outside application webroot with restrictive filesystem permissions
UPLOAD_DIR=/var/civicpulse/uploads
MAX_FILE_SIZE_MB=10

# --- Third-Party Integrations (Optional) ---
# Google Maps Platform API key (for tile geocoding & address lookup)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# Path to service account JSON for FCM push notifications
FIREBASE_CREDENTIALS_PATH=
# Google Cloud OAuth 2.0 Web Client ID (e.g. 123456789-abcdef.apps.googleusercontent.com)
# Used by frontend client for sign-in and by Spring Boot backend for token audience verification
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

